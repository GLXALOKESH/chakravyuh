# MongoDB (TRD section 9).
#
# Atlas:
#   MONGO_URL="mongodb+srv://USER:PASSWORD@cluster0.abcde.mongodb.net/chakravyuh?retryWrites=true&w=majority"
#
# Local mongod, which must be a replica set for the seeder's transaction:
#   MONGO_URL="mongodb://localhost:27017/chakravyuh"
#
# MongoDB Atlas gives you a replica set automatically. A standalone local mongod
# will refuse the seed with "Transactions are not supported by this deployment";
# see the server README for the one-time rs.initiate().
#
# MONGO_URL is the name the TRD uses. It is read only when set explicitly - the
# default from the TRD's configuration table is never treated as a choice, so a
# missing value is reported as "no database" rather than a refused connection.

MONGO_URL="mongodb://placeholder:placeholder@localhost:27017/placeholder"

# How long to wait for MongoDB to pick a server before failing. Cold Atlas
# connections can take a few seconds.
DB_CONNECT_TIMEOUT_MS=10000

# Tests use their own database on the same cluster, so the suite can clear
# collections without touching dev data. Defaults to MONGO_URL with the database
# name replaced by chakravyuh_test.
# TEST_MONGO_URL="mongodb://localhost:27017/chakravyuh_test"

# Python ML service (TRD section 9). Only taint and freeze call it live; both
# fall back to the ring's cached default with "cached": true when it is down.
