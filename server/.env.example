# Copy to .env and fill in. Never commit .env.

# Express
PORT=4000
NODE_ENV=development

# PostgreSQL.
#
# Prisma 7 keeps the connection string out of prisma/schema.prisma: the runtime
# client gets it through @prisma/adapter-pg (src/configs/prisma.ts) and the
# migration CLI gets it through prisma.config.ts. Both read this one variable.
#
# Put a real value here before `npm run migrate:dev`, `npm run seed` or
# `npm start`. The shipped placeholder lets `prisma generate` run with no
# database at all.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chakravyuh"

# Tests use their own schema so truncating can never touch dev data. Set this to
# override the schema name, or leave it unset to append ?schema=chakravyuh_test to
# DATABASE_URL automatically.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chakravyuh?schema=chakravyuh_test"

# Python ML service (TRD section 9). Only taint and freeze call it live; both
# fall back to the ring's cached default with "cached": true when it is down.
ML_URL=http://localhost:8000
ML_TIMEOUT_MS=3000

# Serve contract-shaped mock responses instead of the database.
# Set true during hours 2 to 10, per TRD section 15.
USE_MOCKS=false

# Seed from data/<profile>/ and fall back to src/fixtures/generator.ts when it
# is missing. Dev convenience only; Member 3's generator owns real data.
SEED_FIXTURES=true
SEED_PROFILE=demo

# Replay defaults (TRD section 8 socket table). speed is replay seconds per real
# second, so 60 compresses the 7 day demo into about 10 minutes.
REPLAY_DEFAULT_SPEED=60
REPLAY_TICK_MS=250