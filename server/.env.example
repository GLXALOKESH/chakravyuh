# Copy to .env and fill in. Never commit .env.

# Express
PORT=4000
NODE_ENV=development

# PostgreSQL
# Leave DATABASE_URL unset to use the in-process PGlite database in
# server/.pglite. Same SQL either way, so this is a genuine Postgres in both modes.
# DATABASE_URL=postgres://user:password@host:5432/chakravyuh
# PGLITE_DIR=./.pglite

# Python ML service (TRD section 9)
ML_URL=http://localhost:8000
ML_TIMEOUT_MS=3000

# Serve contract-shaped mock responses instead of the database.
# Set true during hours 2 to 10, per TRD section 15.
USE_MOCKS=false

# Seed from server/devFixtures.js when data/<profile>/ is missing.
# Dev and test convenience only. Member 3's generator owns real data.
SEED_FIXTURES=true
SEED_PROFILE=demo