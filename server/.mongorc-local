# Local replica set for development and load testing.
#
# A replica set is required, not optional: the seeder wraps its whole load in one
# transaction, and MongoDB only permits transactions on a replica set. A plain
# mongod fails with "Transactions are not supported by this deployment".
#
# Tuned for this machine (Apple M4, 10 cores, 16 GB unified memory):
#   cache 8 GB   — half of RAM, so the working set stays in memory
#   10 threads   — one per core; mongod scales roughly linearly to core count
#   compression  — snappy is near-zero CPU on Apple Silicon and saves ~30% disk
#   journal      — kept on. This is a dev database, but a torn write during a
#                  1M-document benchmark would waste the run.
storage:
  dbPath: .mongo-data
  wiredTiger:
    engineConfig:
      cacheSizeGB: 8
      journalCompressor: snappy
      directoryForIndexes: true
systemLog:
  destination: file
  path: .mongo-data/mongod.log
  logAppend: true
net:
  port: 27017
  bindIp: 127.0.0.1
replication:
  replSetName: rs0
