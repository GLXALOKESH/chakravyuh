{
  "name": "chakravyuh-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chakravyuh Express API, Socket.IO replay and evidence pack",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/bin/server.ts",
    "start": "tsx src/bin/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "studio": "prisma studio",
    "seed": "tsx src/bin/seed.ts",
    "seed:fixtures": "SEED_FIXTURES=1 tsx src/bin/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .tsbuildinfo",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
