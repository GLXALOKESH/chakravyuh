ml/models/
*.joblib
*.pkl

# ---- Generated data (TRD section 4: generated, git-ignored) ----
data/demo/
data/train/
data/test/

# ---- Secrets and local environment ----
.env
.env.*
!.env.example
*.pem

# ---- Local databases ----
*.sqlite
*.sqlite3
dump/

# ---- AI assistant tooling ----
# Each folder holds a copy of the same skill bundle with a ~19 MB binary, plus
# machine-local settings. Reinstall the skill locally instead of committing it.
.agent/
.claude/
.cursor/
.gemini/
.opencode/

