# Copy to .env.local to change these. Both are read at build time.

# The Express server (server/). Its REST API is under /api and its replay
# socket on the same origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# auto  ask the server's /health and fall back to the demo built into the
#       client if it does not answer (default)
# live  always use the server
# mock  always use the built-in demo, even if a server is running
NEXT_PUBLIC_DATA_SOURCE=auto
